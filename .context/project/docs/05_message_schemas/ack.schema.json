{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ack",
  "type": "object",
  "required": ["ts", "actor", "refId", "decision"],
  "properties": {
    "ts": { "type": "string" },
    "actor": { "type": "string", "enum": ["OPERATOR", "SYSTEM"] },
    "refId": { "type": "string", "description": "intentId or recommendationId" },
    "decision": { "type": "string", "enum": ["ACK", "REJECT", "EXECUTED"] },
    "notes": { "type": "string" }
  }
}
